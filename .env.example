# 本地环境配置模板（复制为 .env 后填写真实值）
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会被提交。此模板可以安全入库。

# MySQL 连接
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password

# Redis 连接
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT 签名密钥（生产环境务必更换为随机长字符串）
JWT_SECRET=change-this-to-a-random-secret

# 大模型配置
#   mock     = 规则+模板实现，无需 API Key，可完整演示
#   deepseek = 真实调用 DeepSeek（需同时配置 DEEPSEEK_API_KEY）
LLM_PROVIDER=mock
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 中间件开关（默认关闭：系统用线程池 + 静态 URI 也能完整运行，无需中间件）
#   开启前置条件见 README「十、中间件接入」：Nacos 8848、RabbitMQ 5672
NACOS_ENABLED=false
NACOS_ADDR=127.0.0.1:8848
# 注册到 Nacos 的 IP。本机装有 Radmin VPN / VirtualBox 等虚拟网卡时建议显式指定，
# 否则客户端可能选中非业务网卡导致网关访问绕路。
NACOS_IP=127.0.0.1
MQ_ENABLED=false

# RabbitMQ 连接（仅在 MQ_ENABLED=true 时生效）
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=aiops
RABBITMQ_PASSWORD=your-rabbitmq-password

# 网关路由地址。默认走固定端口；
# 开启 NACOS_ENABLED=true 后改为下面的 lb://服务名，由注册中心负载均衡寻址。
# AUTH_URI=lb://aiops-auth-service
# ALERT_URI=lb://aiops-alert-service
# MONITOR_URI=lb://aiops-monitor-service
# AGENT_URI=lb://aiops-agent-service
# TICKET_URI=lb://aiops-ticket-service
# KNOWLEDGE_URI=lb://aiops-knowledge-service
# REPORT_URI=lb://aiops-report-service
# DEMO_URI=lb://aiops-demo-app
